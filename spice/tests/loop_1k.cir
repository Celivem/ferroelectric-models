* Triangular P-V loop at 1 kHz
* Generated by spice/compare_ngspice.py --write-decks (do not edit by hand).
* Run from any directory:  ngspice_con -b loop_1k.cir
* It loads ../build/fecap_nls.osdi (python spice/build_osdi.py) and writes
* loop_1k.dat into the current working directory.
.include ../params/generic.inc
.temp 25
.options method=gear reltol=1e-4

* triangular P-V loop, +-3 V, 1 kHz, from s0 = -1
N1 p1 0 q1 fecap_generic s0=-1 area=1e-10
V1 p1 0 pwl(0 0 0.00025 3 0.00075 -3 0.00125 3 0.00175 -3 0.002 0)
.control
pre_osdi ../build/fecap_nls.osdi
set wr_singlescale
set wr_vecnames
set numdgt=15
tran 1.25e-07 0.002
wrdata loop_1k.dat v(p1) v(q1) i(v1)
.endc
.end
