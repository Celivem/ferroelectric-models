* Reversible depinning pool (E18) at 85 C
* Generated by spice/compare_ngspice.py --write-decks (do not edit by hand).
* Run from any directory:  ngspice_con -b depin.cir
* It loads ../build/fecap_nls.osdi (python spice/build_osdi.py) and writes
* depin.dat into the current working directory.
.include ../params/generic.inc
.temp 85
.options method=gear reltol=1e-4

* generic card with: wk_fq=0.4 wk_rho=0.3 wk_tr=2e-06 wk_q1=2e-06 wk_q2=0.0002 wk_nq=2 wk_ea=0.2
.model fecap_mod fecap_nls wk_fq=0.4 wk_rho=0.3 wk_tr=2e-06 wk_q1=2e-06 wk_q2=0.0002 wk_nq=2 wk_ea=0.2
